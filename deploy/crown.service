[Unit]
Description=Crown AI
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
User=crown
Group=crown
WorkingDirectory=/srv/crown
EnvironmentFile=/etc/crown/crown.env
ExecStart=/srv/crown/.venv/bin/gunicorn -c deploy/gunicorn.conf.py "crown.web:create_app()"
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

# The application needs to read its code and talk to Postgres. It does not
# need to write to the filesystem, see other users' processes, or gain
# privileges — and a compromised web process that can do none of those is a
# much smaller problem than one that can.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/crown/run
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
