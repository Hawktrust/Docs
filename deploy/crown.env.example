# Every variable Crown reads. Copy to /etc/crown/crown.env, mode 0600, root.
# Nothing here is a real value.

# ---------------------------------------------------------------- database
# crown_app owns nothing. Row-level security does not constrain a table's
# owner, so an application connecting as the owner bypasses every policy in
# the schema. If you change one line in this file, do not change this one.
CROWN_DSN=postgresql://crown_app:CHANGE_ME@127.0.0.1:5432/crown_ai

# ----------------------------------------------------------------- secrets
# Session cookies. Rotate as often as you like — nothing depends on an old
# value still verifying.
CROWN_SECRET=CHANGE_ME_64_RANDOM_BYTES

# Opt-out links. SEPARATE from the above on purpose: s18 of the Spam Act gives
# an unsubscribe link at least 30 days of life, so rotating the cookie secret
# must not be able to break one. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
CROWN_OPTOUT_SECRET=CHANGE_ME_DIFFERENT_64_RANDOM_BYTES

# Retired opt-out secrets, comma separated. They verify but never sign. Keep
# each one here for 30 days past the last message signed with it, then drop it.
CROWN_OPTOUT_SECRET_PREVIOUS=

# ------------------------------------------------------------------ public
# Where the opt-out link points. Must be the address a recipient can reach
# from outside, not an internal hostname — a link a landholder cannot open is
# not a functional unsubscribe facility under s18.
CROWN_BASE_URL=https://crown.example.com

# ---------------------------------------------------------------- must NOT
# be set in production. It exists for the test client and turns off Secure on
# the session cookie.
# CROWN_INSECURE_COOKIES=1
