# TLS termination in front of gunicorn. Crown assumes something does this;
# CROWN_INSECURE_COOKIES must stay unset, which means the session cookie is
# Secure, which means a plain-HTTP deployment cannot log anybody in.

server {
    listen 443 ssl http2;
    server_name crown.example.com;

    ssl_certificate     /etc/letsencrypt/live/crown.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/crown.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "DENY" always;
    add_header Referrer-Policy           "same-origin" always;

    # The opt-out endpoint is reached by people who did not ask to hear from
    # Crown, from links in messages sent up to 30 days ago. It must stay
    # reachable without a session and must not be rate-limited into
    # uselessness: s18 wants a FUNCTIONAL unsubscribe facility, and one that
    # returns 429 to somebody trying twice is not functional.
    location /opt-out/ {
        limit_req zone=optout burst=20 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include proxy_params;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Generous on purpose. See the comment on /opt-out/ above.
limit_req_zone $binary_remote_addr zone=optout:10m rate=30r/m;

server {
    listen 80;
    server_name crown.example.com;
    return 301 https://$host$request_uri;
}
